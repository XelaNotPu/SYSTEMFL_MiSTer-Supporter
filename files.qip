# PATREON: DB9/DB15 pad support on USER_IO -- the joydb files are framework
# (MiSTer-DB9 fork) and are listed in sys/sys.qip, not here.
# PATREON: CRT Adjust (rmonic79, GPLv3). crt_adjust.sv / crt_adjust_mlab.sv are verbatim copies of
# the SUPER22 core's modules; fl_crtadj.sv is the System FL glue at the emu video boundary.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/crt_adjust.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/crt_adjust_mlab.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/fl_crtadj.sv
