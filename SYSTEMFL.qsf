set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE PERFORMANCE"
set_global_assignment -name VERILOG_MACRO "SYSTEMFL_DEVELOPMENT=1"
set_global_assignment -name VERILOG_MACRO "SYSTEMFL_INTEL_RAM=1"
source sys/sys.tcl
source sys/sys_analog.tcl
# [MiSTer-DB9] sys/sys.tcl still puts PIN_AE15 on SD_SPI_CS, which sys_top.v no longer
# exposes as a port; reclaim that pin as USER_IO[7] (DB9 pin 8). Same override as
# SUPER22_MiSTer/SUPER22.qsf. Must come after `source sys/sys.tcl`.
set_location_assignment PIN_AE15 -to "USER_IO[7]"
source files.qip

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"